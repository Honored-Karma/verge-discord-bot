{
  "name": "discord-rpg-bot",
  "version": "2.0.0",
  "description": "Discord RPG bot with training, AP/SP progression, and admin tools",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js",
    "test": "node --test",
    "migrate:public-ids": "node scripts/migrate-public-ids.js",
    "applications:import": "node scripts/import-applications.js",
    "wiki:import": "node scripts/import-wiki.js",
    "build": "npm --prefix web install && npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "keywords": [
    "discord",
    "bot",
    "rpg",
    "training"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "^6.21.0",
    "ms": "^2.1.3",
    "node-cron": "^4.2.1"
  }
}
