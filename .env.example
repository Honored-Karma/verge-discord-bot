# ==============================================================================
# Discord Bot & Application Configuration
# Get these values from https://discord.com/developers/applications
# ==============================================================================

# Your bot token (REQUIRED for bot operations)
DISCORD_TOKEN=your_token_here

# Application / Client ID (REQUIRED for Discord OAuth2 and Command Deployment)
CLIENT_ID=your_client_id_here
DISCORD_CLIENT_ID=your_client_id_here

# Discord OAuth2 Client Secret (REQUIRED for Web Portal Discord Login)
# Found in: Discord Developer Portal -> Your App -> OAuth2 -> General -> Client Secret
DISCORD_CLIENT_SECRET=your_oauth2_client_secret_here

# Web Portal Base URL and OAuth2 Redirect URI
# In development: http://localhost:3000
# In production: https://your-domain.railway.app
WEB_BASE_URL=http://localhost:3000
# Для аватаров /vupper нужен доступный Discord публичный HTTPS-адрес этого сервера.
# Файлы сохраняются в MongoDB и выдаются через WEB_BASE_URL/api/avatar/…
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Web Server & API Port (default: 3000)
PORT=3000

# Trust Reverse Proxy (1 for single reverse proxy like Cloudflare/Railway/Nginx; 0/false for direct exposure)
TRUST_PROXY=1

# Express Session Encryption Secret (REQUIRED for production security)
# Generate a strong 64-character random string: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=your_secure_random_session_secret_string

# ==============================================================================
# Database Configuration
# ==============================================================================

# MongoDB Connection URI (REQUIRED for both Bot and Web Portal)
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=VergeTRP
MONGODB_URI=your_mongodb_uri_here

# ==============================================================================
# Discord Guild & Permissions Configuration
# ==============================================================================

# Guild ID for instant command deployment and server member role verification
GUILD_ID=your_guild_id_here

# Admin Discord User IDs (comma-separated list of Discord user IDs with full access)
ADMIN_IDS=user_id_1,user_id_2

# Staff Role IDs (configured for Discord server roles)
# Администратор (Admin - full access to bot & web administration)
ADMIN_ROLE_IDS=1438987035862892544

# Главный ГМ (Head Game Master - GM commands + /set's, multipliers, logs, etc.)
HEAD_GM_ROLE_IDS=1438987072026185808

# Главный Анкетолог (Head Profile Reviewer - Anketolog commands + /set's, slot grant, etc.)
HEAD_ANKETOLOG_ROLE_IDS=1438987088975626251

# Анкетолог (Profile Reviewer - give-style, /accept, /add-currency, physical register/edit)
ANKETOLOG_ROLE_IDS=1431759459528610013

# Мастер Игры (Game Master - add-ap, add-sp, give-style, add-currency, add-reputation, purge-offtop, mission create)
GM_ROLE_IDS=1431759694179074162

# Role IDs for limited admin commands (legacy fallback)
LIMITED_ADMIN_ROLE_IDS=1431759694179074162
MODERATOR_ROLE_IDS=role_id_for_moderators

# Role IDs for style-giving commands (give-style, remove-player-style)
GIVE_STYLE_ROLE_IDS=role_id_3,role_id_4

# Role given to accepted players upon application approval
PLAYER_ROLE_ID=1431761095319879892

# Роль игрока для РП (опционально, по умолчанию используется PLAYER_ROLE_ID)
RP_ROLE_ID=1431761095319879892

# Role removed from accepted players upon application approval (candidate/unverified)
UNVERIFIED_ROLE_ID=1431758535905120266

# ==============================================================================
# Automation & Scheduler Configuration
# ==============================================================================

# Weekly salary scheduler cron expression
# Default: Every Monday at 12:00 UTC
SALARY_CRON=0 12 * * 1
SALARY_TIMEZONE=UTC
SALARY_LOG_CHANNEL_ID=channel_id_for_salary_logs

# Канал для общих логов команд (/logs, админ-действия, покупки и т.д.)
LOGS_CHANNEL_ID=channel_id_for_command_logs

# Отдельный канал для логов тренировок (/train-ap, /train-sp, /social-rp).
# Если не задан, тренировочные логи отправляются в LOGS_CHANNEL_ID или настроенные через /log-enable каналы.
TRAINING_LOG_CHANNEL_ID=channel_id_for_training_logs

# Канал, куда бот присылает админам уведомления о покупках в магазине.
# Если не задано, используется админский канал сервера по умолчанию.
SHOP_LOG_CHANNEL_ID=channel_id_for_shop_purchases

# Optional emoji prefixes for Discohook parser command
UI_TITLE_EMOJI=✨
UI_FIELD_EMOJI=🔹


